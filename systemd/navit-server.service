[Unit]
Description=Navi pack bake (dedicated navit-server user)
Documentation=file:///media/navi/navi-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=navit-server
Group=navit-server
WorkingDirectory=/media/navi/navi-server/scripts
Environment=NAVI_PACK_CONFIG=/media/navi/navi-server/data/config.env
# Nice/IO: convert is CPU-heavy; leave headroom on a shared box.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/media/navi/navi-server/scripts/run-weekly.sh
SuccessExitStatus=0
# Runtime data lives under the service home; never expose scratch/state over HTTP.
ReadWritePaths=/media/navi/navi-server/data
ReadOnlyPaths=/media/navi/navi-server/scripts /media/navi/navi-server/http /media/navi/navi-server/systemd /media/navi/navi-server/docs
# In-repo convert binary (cargo build --release -p navi-indexed-convert).
ReadOnlyPaths=/media/navi/navi-server/target/release
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
