[Unit]
Description=Navi MWM CoMaps release check (daily); bake only when enabled
Documentation=file:///media/navi/navi-server/docs/mwm-pipeline.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Dedicated system user (same as pack/DATEX/DDNS). Created by setup-server.sh
# --apply-service (NAVI_SERVICE_USER, default navit-server).
User=navit-server
Group=navit-server
# Raise fd ceiling only (does not reserve/allocate RAM or CPU). Default soft
# limits (~1024) can EMFILE during parallel leaf/cache I/O; 65536 is typical.
LimitNOFILE=65536
# Do not Restart=on-failure here: a failing bake with NAVI_MWM_ENABLED=1 would
# otherwise restart every RestartSec and storm the host. Daily timer re-arms.
Environment=NAVI_MWM_ENABLED=0
Environment=NAVI_MWM_MODE=comaps-release
EnvironmentFile=-/etc/navi/mwm.env
WorkingDirectory=/opt/navi/navi-server
# Detect-only when NAVI_MWM_ENABLED=0 (default). Never starts bake/publish
# unless enabled=1 and check reports a new CoMaps release (exit 10).
ExecStart=/opt/navi/navi-server/scripts/mwm/check-or-bake.sh
Nice=10
# Path allow-lists matter once ProtectSystem= is enabled via drop-in.
# Default: User= is the boundary; add ProtectSystem=strict only after paths
# in /etc/navi/mwm.env (BUILD_DIR, caches, scratch) are covered.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
