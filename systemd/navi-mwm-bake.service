[Unit]
Description=Navi MWM bake (default: comaps-release sidecars; generate mode optional)
Documentation=file:docs/client-fetch-mwm.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NAVI_MWM_ENABLED=0
Environment=NAVI_MWM_MODE=comaps-release
EnvironmentFile=-/etc/navi/mwm.env
WorkingDirectory=/opt/navi/navi-server
ExecStart=/opt/navi/navi-server/scripts/mwm/run-mwm-bake.sh
# generate mode Nordic peak ~19–20 GiB; comaps-release streaming is far lower.
MemoryMax=24G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
