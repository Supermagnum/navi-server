[Unit]
Description=Navi MWM bake (default: comaps-release sidecars; generate mode optional)
Documentation=file:docs/client-fetch-mwm.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Resume via processed.json after crash; lock released when ExecStart exits.
Restart=on-failure
RestartSec=120
Environment=NAVI_MWM_ENABLED=0
Environment=NAVI_MWM_MODE=comaps-release
EnvironmentFile=-/etc/navi/mwm.env
WorkingDirectory=/opt/navi/navi-server
ExecStart=/opt/navi/navi-server/scripts/mwm/run-mwm-bake.sh
# generate mode Nordic peak ~19–20 GiB (test-only).
# Parallel comaps-release: N * ~8.2 GiB + 16 GiB headroom (see leaf_scheduler /
# config/mwm/measured-peaks.json). Concurrency 3 on media needs >24G cgroup.
MemoryMax=48G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
