[Unit]
Description=Navi MWM bake (default: comaps-release sidecars; generate mode optional)
Documentation=file:///media/navi/navi-server/docs/mwm-pipeline.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Dedicated system user (same as pack/DATEX/DDNS). Created by setup-server.sh
# --apply-service (NAVI_SERVICE_USER, default navit-server).
User=navit-server
Group=navit-server
# Raise fd ceiling only (does not reserve/allocate RAM or CPU). Default soft
# limits (~1024) can EMFILE during parallel leaf/cache I/O; 65536 is typical.
LimitNOFILE=65536
# Resume via processed.json after crash; lock released when ExecStart exits.
Restart=on-failure
RestartSec=120
Environment=NAVI_MWM_ENABLED=0
Environment=NAVI_MWM_MODE=comaps-release
EnvironmentFile=-/etc/navi/mwm.env
WorkingDirectory=/opt/navi/navi-server
ExecStart=/opt/navi/navi-server/scripts/mwm/run-mwm-bake.sh
# generate mode Nordic peak ~19–20 GiB (test-only).
# Parallel comaps-release: N * ~8.2 GiB + 16 GiB headroom (see leaf_scheduler /
# config/mwm/measured-peaks.json). Concurrency 3 on media needs >24G cgroup.
MemoryMax=48G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Path allow-lists matter once ProtectSystem= is enabled via drop-in.
# Default: User= is the boundary; add ProtectSystem=strict only after paths
# in /etc/navi/mwm.env (BUILD_DIR, caches, scratch) are covered.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
