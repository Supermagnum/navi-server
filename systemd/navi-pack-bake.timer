[Unit]
Description=Weekly timer for Navi indexed pack bake (Mon 00:00 UTC)
Documentation=file:///media/navi/navi-server/README.md

[Timer]
# Default: Monday 00:00 UTC. Override by editing this file (or regenerating via
# setup) — keep Timezone=UTC unless you intentionally want local wall clock.
# Region processing order follows the local-night terminator from that start
# instant (see NAVI_BAKE_SUN_ORDER / scripts/sun-order-regions.py).
OnCalendar=Mon *-*-* 00:00:00
Timezone=UTC
Persistent=true
RandomizedDelaySec=15m
Unit=navi-pack-bake.service

[Install]
WantedBy=timers.target
