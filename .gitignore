# Runtime / scratch — never commit extracts, packs, or logs
/data/scratch/
/data/staging/
/data/generations/
/data/state/
/data/logs/
/data/live
/data/previous
/data/CURRENT_GENERATION
/data/published/packs/
/data/published/current.json
