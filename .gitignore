# Runtime / scratch — never commit extracts, packs, or logs
/data/scratch/
/data/staging/
/data/generations/
/data/state/
/data/logs/
/data/live
/data/previous
/data/CURRENT_GENERATION
/data/published/packs/
/data/published/current.json
/data/published/.staging/

# Local runtime copies (templates stay tracked under scripts/).
# data/regions.conf is created by setup-server from regions.example.conf —
# keep portable terrain_class / skip_reason / band overrides in the example
# so investigative tags are versioned; the local file remains the runtime
# merge source for planet-leaves and may diverge per deployment.
/data/config.env
/data/regions.conf
/data/ddns.env
/data/secrets/
/data/datex_npra/
/data/published/datex/

# DEM tiles (keep directory structure via README + .gitkeep)
/data/elevation/copernicus/**
/data/elevation/viewfinder/**
/data/elevation/srtm/**
!/data/elevation/**/.gitkeep
# Persistent Copernicus ocean-404 negative cache (runtime; see elevation/README.md)
/data/elevation/copernicus_ocean_404.txt

# Editor / OS junk
*.swp
*~
.DS_Store
__pycache__/
*.py[cod]

# Runtime locks / DEM downloads (never commit)
.tile_locks/
/data/.publish.lock
/data/elevation/.tile_locks/
/copernicus/

