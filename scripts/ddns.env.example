# Dynamic DNS credentials for navi-server (optional).
# Copy to /media/navi/navi-server/data/ddns.env and chmod 600.
# Installed/enabled by: sudo setup-server.sh --apply-ddns
# Removed by:            sudo uninstall-ddns.sh

# Provider: duckdns | cloudflare | url
NAVI_DDNS_PROVIDER=duckdns

# FQDN to publish (A record). For DuckDNS this is usually <name>.duckdns.org
NAVI_DDNS_HOSTNAME=

# Shared secret / API token (DuckDNS token, Cloudflare API token, or URL token).
NAVI_DDNS_TOKEN=

# Cloudflare only (API token needs Zone.DNS Edit).
# NAVI_DDNS_CF_ZONE_ID=
# NAVI_DDNS_CF_RECORD_ID=     # optional; looked up by hostname if empty
# NAVI_DDNS_CF_PROXIED=false
# NAVI_DDNS_CF_TTL=120

# Generic HTTP update URL. Placeholders: {ip} {hostname} {token}
# Example (afraid.org / custom): https://example/update?host={hostname}&token={token}&ip={ip}
# NAVI_DDNS_UPDATE_URL=

# Public IPv4 discovery URL (must return plain text IPv4 only).
NAVI_DDNS_IP_URL=https://api.ipify.org

# Skip provider call when the public IP matches the last successful update.
NAVI_DDNS_SKIP_UNCHANGED=1
