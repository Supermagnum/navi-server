# Template for optional RadioID mirror (copy keys into data/config.env).
# Off by default. See docs/repeater-mirror.md.
#
# Optional API token goes in data/secrets/radioid.env — never here.

NAVI_RADIOID_ENABLED=0
# Set ONLY after written permission from RadioID covers redistribution:
RADIOID_PERMISSION_CONFIRMED=0

NAVI_RADIOID_API_BASE=https://radioid.net/api
NAVI_RADIOID_MAP_URL=https://database.radioid.net/static/map.json
NAVI_RADIOID_COUNTRIES=Norway

NAVI_RADIOID_APP_NAME=navi-server-radioid
NAVI_RADIOID_APP_VERSION=0.1
NAVI_RADIOID_CONTACT=REPLACE_WITH_APPROVED_CONTACT
# NAVI_RADIOID_USER_AGENT=
# NAVI_RADIOID_SECRETS_FILE=/media/navi/navi-server/data/secrets/radioid.env
# NAVI_RADIOID_PER_PAGE=200
# NAVI_RADIOID_PAGE_DELAY_SECS=0.25
