# Template for optional RepeaterBook mirror (copy keys into data/config.env).
# Off by default. See docs/repeaterbook-mirror.md.
#
# Secrets (app_ token) go in data/secrets/repeaterbook.env — never here.

NAVI_REPEATERBOOK_ENABLED=0
# Set ONLY after written permission from RepeaterBook covers redistribution:
REPEATERBOOK_PERMISSION_CONFIRMED=0

NAVI_REPEATERBOOK_BASE_URL=https://www.repeaterbook.com/api
# RepeaterBook country query names (comma-separated). Start with Norway.
NAVI_REPEATERBOOK_COUNTRIES=Norway
# Optional overrides: Norway:no,Sweden:se
# NAVI_REPEATERBOOK_COUNTRY_SLUGS=

# App identity — must match exactly what RepeaterBook approved:
NAVI_REPEATERBOOK_APP_NAME=navi-server-repeaterbook
NAVI_REPEATERBOOK_APP_VERSION=0.1
NAVI_REPEATERBOOK_CONTACT=REPLACE_WITH_APPROVED_CONTACT
# Or set the full User-Agent literally (overrides the three fields above):
# NAVI_REPEATERBOOK_USER_AGENT=navi-server-repeaterbook/0.1 (+https://github.com/Supermagnum/navi-server; you@example.com)

# NAVI_REPEATERBOOK_SECRETS_FILE=/media/navi/navi-server/data/secrets/repeaterbook.env
# NAVI_REPEATERBOOK_KEEP_GENERATIONS=2
# NAVI_REPEATERBOOK_MAX_RETRIES=4
# NAVI_REPEATERBOOK_COUNT_RATIO_MIN=0.25
# NAVI_REPEATERBOOK_COUNT_RATIO_MAX=4.0
