# DATEX NPRA redistribution (optional, off by default)
#
# navi-server holds NPRA credentials and polls DATEX II v3.1 snapshots;
# clients only GET cached XML from data/published/datex/ (read-only).
# See docs/datex-npra.md. Navi client UI/plugin work is out of scope here.
#
# HARD DEFAULT: leave ENABLED=0. Nothing talks to vegvesen.no until you
# answer yes to the DATEX prompt in setup-server.sh (or --apply-datex).
NAVI_DATEX_NPRA_ENABLED=0

# Production DATEX node (HTTP GET pullsnapshotdata).
NAVI_DATEX_NPRA_BASE_URL=https://datex-server-get-v3-1.atlas.vegvesen.no

# Comma-separated endpoint names (mapped to …/datexapi/<Name>/pullsnapshotdata).
NAVI_DATEX_NPRA_ENDPOINTS=GetSituation,GetTravelTimeData,GetMeasuredWeatherData,GetCCTVSiteTable

# Poll cadence (seconds) between timer firings; per-run jitter is applied in-process.
NAVI_DATEX_NPRA_POLL_INTERVAL_SECS=300
# Per-endpoint cadence (seconds). Timer still fires ~5min; longer
# intervals skip upstream GET via next_attempt_unix until due.
# GetCCTVSiteTable=43200 (12h): site metadata, not live camera images.
NAVI_DATEX_NPRA_ENDPOINT_INTERVALS=GetSituation=300,GetTravelTimeData=300,GetMeasuredWeatherData=600,GetCCTVSiteTable=43200

# Conditional GET using stored Last-Modified (304 = success, no body change).
NAVI_DATEX_NPRA_USE_IF_MODIFIED_SINCE=1

# Mandatory identifying User-Agent (app + contact). Replace contact before enable.
NAVI_DATEX_NPRA_USER_AGENT="navi-server-datex/0.1 (contact: REPLACE_WITH_YOUR_EMAIL_OR_URL)"

# Credentials: prefer process env NAV_DATEX_USERNAME / NAV_DATEX_PASSWORD.
# Else a mode-0600 secrets file outside git (never commit):
# NAVI_DATEX_NPRA_SECRETS_FILE=/media/navi/navi-server/data/secrets/datex_npra.env
