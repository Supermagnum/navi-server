# Copy to /media/navi/navi-server/data/config.env and edit.
# Prototype defaults — safe for a single-region Hedmark smoke test.

NAVI_PACK_ROOT=/media/navi/navi-server/data
NAVI_REGIONS_CONF=/media/navi/navi-server/data/regions.conf

# Dedicated system user/service for bake jobs (created by setup-server.sh
# --apply-service). Unit name: navit-server.service
NAVI_SERVICE_USER=navit-server

# Profiles passed to navi-indexed-convert (comma-separated).
NAVI_PROFILES=car,foot

# Elevation Δh bake (edge_delta_h_m). Default ON.
# Set NAVI_BAKE_DELTA_H=0 to disable. When on, NAVI_ELEV_DIR is required.
NAVI_BAKE_DELTA_H=1
NAVI_ELEV_DIR=/media/navi/navi-server/data/elevation

# Optional town-to-town OD bake (no builder in-tree yet; stub no-ops unless set).
NAVI_BAKE_TOWN_ROUTES=0
NAVI_TOWN_ROUTE_BIN=

# Convert binary is always built in-repo:
#   cd /media/navi/navi-server && cargo build --release -p navi-indexed-convert
# → target/release/navi-indexed-convert

# Blue-green: keep this many published generations (live + previous minimum).
NAVI_KEEP_GENERATIONS=2
# Per-region published packs: keep this many *prior* gens after a successful
# update (0 = only latest). Failed updates never delete the last-known-good.
NAVI_PUBLISHED_KEEP_PER_REGION=1

# Weekly bake schedule (systemd timer default Mon 00:00 UTC — see
# systemd/navi-pack-bake.timer). Ordering follows the sun/local-night
# terminator from the bake start instant so regions tend to convert near
# their own local night rather than alphabetical order.
# NAVI_BAKE_SUN_ORDER=1
# NAVI_BAKE_START_UNIX=          # optional; default = process start time
# NAVI_BAKE_TIMER_ONCALENDAR=Mon *-*-* 00:00:00
#
# Convert thread/tile concurrency on the weekly path is owned solely by
# pack-convert-core WorkerPoolPlan (detect cores + MemAvailable). Do NOT set
# NAVI_TILE_BUILD_CONCURRENCY in config.env on the small VPS (8c/16 GiB) —
# run-weekly.sh will not set it either. Leave unset for autodetection.
# NAVI_TILE_BUILD_CONCURRENCY=

# Parallel smoke (run-planet-smoke-parallel.sh) — auto-detects cores/RAM;
# override only when needed on a leased server. Not used by run-weekly.sh.
# NAVI_SMOKE_RESERVE_CORES=2
# NAVI_SMOKE_RESERVE_RAM_GIB=8
# NAVI_SMOKE_THREADS_PER_WORKER=4
# NAVI_SMOKE_RSS_GIB_PER_WORKER=6
# NAVI_SMOKE_MAX_JOBS=0
# NAVI_SMOKE_LARGE_DEM_CELLS=150
# NAVI_SMOKE_QUOTA_ABORT_PCT=90
# NAVI_SMOKE_EVICT_DEM=1

# Batched full-leaf bake (run-planet-leaves-batched.sh): max estimated
# PBF+pack scratch per batch (GiB). Path-parent composites are skipped.
# NAVI_PLANET_BATCH_SCRATCH_GIB=80

# Fetch: transient HTTP/network failures (502/503/timeout/DNS/reset) retry with
# exponential backoff + recovery HEAD probes until this budget (seconds), then
# the orchestrator PAUSED hold. needs_human (404/401/403) and ambiguous codes
# still fail immediately. See scripts/lib/fetch_http_classify.sh.
# Tuned 2026-09-07: ~1h Geofabrik 502 outage hit the old 3600s ceiling →
# budget 7200s (~2h), recovery probe interval 60s (was 30s). Backoff
# 30→…→300 unchanged (curve still fine; longer window just runs longer).
# NAVI_FETCH_TRANSIENT_BUDGET_SECS=7200
# NAVI_FETCH_BACKOFF_INITIAL_SECS=30
# NAVI_FETCH_BACKOFF_MAX_SECS=300
# NAVI_FETCH_RECOVERY_CLEAN_NEED=3
# NAVI_FETCH_RECOVERY_INTERVAL_SECS=60

# Geofabrik regional .osc.gz incremental updates. run-weekly.sh passes
# fetch-extracts.sh --prefer-incremental for all regions in NAVI_REGIONS_CONF
# (skipped with --force-fetch). Default retention matches Geofabrik's ~100-day
# / ~3-month documented window. See docs/incremental-geofabrik.md and
# docs/vps-prelaunch-checklist.md (held-PBF retention / scrub defaults).
# NAVI_GEOFABRIK_DIFF_RETENTION_DAYS=100

# HTTP static root only — never point a public server at data/ as a whole.
# NAVI_PUBLISHED_DIR=/media/navi/navi-server/data/published

# Disk space gate (percent full). Fail loudly near full before large downloads.
# Capacity is filesystem disk space via `df` on NAVI_PACK_ROOT. ZFS is optional:
# set NAVI_ZFS_DATASET only when you want zfs property reporting; leave empty
# or omit on non-ZFS hosts.
# NAVI_ZFS_DATASET=Mypool/navi
NAVI_QUOTA_WARN_PCT=85
NAVI_QUOTA_FAIL_PCT=95

# Self-maintaining scrub (cleanup.sh / navi-pack-scrub.timer). Enabled by
# setup-server.sh --apply-service. Also runs at the end of each weekly bake.
# Extracts are not age-deleted by default (held PBFs for Geofabrik incremental).
# Weekly and navi-pack-scrub.service both pass --no-extracts. Opt in to
# age-prune with --prune-extracts or NAVI_SCRUB_PRUNE_EXTRACTS=1.
#
# Held-PBF disk policy (defaults sized for 8c/16GiB/512GB weekly host):
#   NAVI_HELD_PBF_MAX_MIB=512     # drop any held PBF larger than this (0=off)
#   NAVI_HELD_PBF_BUDGET_GIB=40   # cap total held bytes; drop largest first (0=off)
# Large bake hosts may set both to 0. See docs/incremental-geofabrik.md.
NAVI_LOG_KEEP_DAYS=14
NAVI_CONVERT_SCRATCH_KEEP_DAYS=7
NAVI_EXTRACT_KEEP_DAYS=21
NAVI_STAGING_KEEP_DAYS=2
# NAVI_HELD_PBF_MAX_MIB=512
# NAVI_HELD_PBF_BUDGET_GIB=40

# Dynamic DNS (optional). Secrets live in data/ddns.env (see scripts/ddns.env.example).
#   sudo setup-server.sh --apply-ddns
#   sudo uninstall-ddns.sh [--purge]
# NAVI_DDNS_ENV=/media/navi/navi-server/data/ddns.env

# ---------------------------------------------------------------------------
# DATEX NPRA redistribution (OPTIONAL — OFF BY DEFAULT)
# Full docs: docs/datex-npra.md
# Enable via interactive setup (yes/no + username/password) or --apply-datex
# Uninstall:       sudo uninstall-datex-npra.sh [--purge]
# Do NOT set ENABLED=1 without NPRA credentials; poller fails closed.
# Credentials: env NAV_DATEX_USERNAME / NAV_DATEX_PASSWORD, else secrets file.
# ---------------------------------------------------------------------------
NAVI_DATEX_NPRA_ENABLED=0
NAVI_DATEX_NPRA_BASE_URL=https://datex-server-get-v3-1.atlas.vegvesen.no
NAVI_DATEX_NPRA_ENDPOINTS=GetSituation,GetTravelTimeData,GetMeasuredWeatherData,GetCCTVSiteTable
NAVI_DATEX_NPRA_POLL_INTERVAL_SECS=300
# Per-endpoint cadence (seconds). Timer still fires ~5min; longer
# intervals skip upstream GET via next_attempt_unix until due.
# GetCCTVSiteTable=43200 (12h): site metadata, not live camera images.
NAVI_DATEX_NPRA_ENDPOINT_INTERVALS=GetSituation=300,GetTravelTimeData=300,GetMeasuredWeatherData=600,GetCCTVSiteTable=43200
NAVI_DATEX_NPRA_USE_IF_MODIFIED_SINCE=1
# Must be quoted — parentheses break `source` otherwise. Replace the placeholder
# contact before enabling; leave empty credentials (never put secrets here).
NAVI_DATEX_NPRA_USER_AGENT="navi-server-datex/0.1 (contact: REPLACE_WITH_YOUR_EMAIL_OR_URL)"
# Secrets file path only (no username/password in this template):
# NAVI_DATEX_NPRA_SECRETS_FILE=/media/navi/navi-server/data/secrets/datex_npra.env

# Size sanity bands vs source PBF (MiB pack / MiB PBF). Global defaults —
# Hedmark monolithic ratios (~0.43 graph) are guidance only. Tiled regions
# (e.g. West Virginia) can be an order of magnitude larger due to tile overlap.
# Do NOT widen these globals for a single wetland-heavy county: put a
# per-region override on the regions.conf line instead, e.g.
#   hedmark  url:...  wetland_max_ratio=1.0
# For polar / Arctic-archipelago sparsity use terrain_class=polar_sparse
# (relaxes ONLY graph_min to NAVI_SIZE_GRAPH_MIN_RATIO_POLAR_SPARSE below).
# For mire / mangrove / coastal-marsh / delta extracts use
# terrain_class=wetland_heavy (relaxes ONLY wetland_max to
# NAVI_SIZE_WETLAND_MAX_RATIO_WETLAND_HEAVY).
# For fine-grained residential/service road tagging (high graph pack/PBF)
# use terrain_class=dense_network (relaxes ONLY graph_max to
# NAVI_SIZE_GRAPH_MAX_RATIO_DENSE_NETWORK). Multiple classes:
#   terrain_class=wetland_heavy,dense_network
# (see scripts/regions.example.conf). validate-packs.sh falls back to these
# globals for any region without an explicit override / terrain_class.
NAVI_SIZE_GRAPH_MIN_RATIO=0.10
NAVI_SIZE_GRAPH_MAX_RATIO=20.0
NAVI_SIZE_GRAPH_MIN_RATIO_POLAR_SPARSE=0.001
NAVI_SIZE_GRAPH_MAX_RATIO_DENSE_NETWORK=28.0
NAVI_SIZE_POI_MIN_RATIO=0.01
NAVI_SIZE_POI_MAX_RATIO=1.50
NAVI_SIZE_WETLAND_MIN_RATIO=0.0
NAVI_SIZE_WETLAND_MAX_RATIO=0.50
NAVI_SIZE_WETLAND_MAX_RATIO_WETLAND_HEAVY=1.0
NAVI_SIZE_TOTAL_MIN_RATIO=0.05
NAVI_SIZE_TOTAL_MAX_RATIO=25.0
# Flag if a pack type grew/shrank by more than this vs previous live generation.
NAVI_SIZE_VS_PREV_MAX_FACTOR=3.0
